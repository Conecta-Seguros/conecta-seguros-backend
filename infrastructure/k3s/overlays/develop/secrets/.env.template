# ------------------------------------------------------------------------------
# PostgreSQL - Primary Database
# ------------------------------------------------------------------------------
# JDBC connection URL | Format: jdbc:postgresql://<host>:<port>/<database>
POSTGRES_FUSIONAUTH_URL=

# Database port | Default: 5432
POSTGRES_FUSIONAUTH_PORT=

# Application database user (read/write access)
POSTGRES_FUSIONAUTH_USER=

# Database administrator user (full privileges)
POSTGRES_FUSIONAUTH_ROOT_USER=

# Application user password | Min 20 alphanumeric characters
POSTGRES_FUSIONAUTH_PASSWORD=

# Administrator user password | Min 20 alphanumeric characters
POSTGRES_FUSIONAUTH_ROOT_PASSWORD=

# Database name
POSTGRES_FUSIONAUTH_DB=

# ------------------------------------------------------------------------------
# PostgreSQL - Backup Database
# ------------------------------------------------------------------------------
# JDBC connection URL for backup database
POSTGRES_FUSIONAUTH_BACKUP_URL=

# Backup database port | Default: 5432
POSTGRES_FUSIONAUTH_BACKUP_PORT=

# Backup database administrator user
POSTGRES_FUSIONAUTH_BACKUP_ROOT_USER=

# Backup administrator password | Min 20 alphanumeric characters
POSTGRES_FUSIONAUTH_BACKUP_ROOT_PASSWORD=

# Backup database name
POSTGRES_FUSIONAUTH_BACKUP_DB=

# Backup retention period in days | Example: 7
POSTGRES_FUSIONAUTH_BACKUP_RETENTION_DAYS=

# ------------------------------------------------------------------------------
# FusionAuth Application
# ------------------------------------------------------------------------------
# JVM memory allocation | Format: <number>m or <number>g | Example: 512m, 1g
FUSIONAUTH_APP_MEMORY=

# Runtime mode | Values: development, production
FUSIONAUTH_APP_RUNTIME_MODE=

# Public URL | Example: http://localhost:9011 or https://auth.example.com
FUSIONAUTH_APP_URL=

# Administrative API key | Min 20 alphanumeric characters
FUSIONAUTH_API_KEY=

# Log level | Values: TRACE, DEBUG, INFO, WARN, ERROR
FUSIONAUTH_APP_LOG_LEVEL=

# Search engine type | Values: database, elasticsearch
FUSIONAUTH_APP_SEARCH_TYPE=

# ------------------------------------------------------------------------------
# Scheduled Jobs
# ------------------------------------------------------------------------------
# System backup retention period in days | Example: 7
BACKUP_RETENTION_DAYS=

# Data export retention period in days | Example: 30
EXPORT_RETENTION_DAYS=

# Target Kubernetes namespaces (comma-separated) | Example: develop,staging
TARGET_NAMESPACES=
