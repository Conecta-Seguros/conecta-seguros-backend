# ------------------------------------------------------------------------------
# PostgreSQL - Primary Database
# ------------------------------------------------------------------------------
# Database port | Default: 5432
POSTGRES_PORT=

# Root database administrator user
POSTGRES_ROOT_USER=

# Root user password | Min 20 alphanumeric characters
POSTGRES_ROOT_PASSWORD=

# ──────────────────────────────────────────────────────────────────────────────

# ------------------------------------------------------------------------------
# PostgreSQL - FusionAuth Database
# ------------------------------------------------------------------------------
# JDBC connection URL | Format: jdbc:postgresql://<host>:<port>/<database>
POSTGRES_FUSIONAUTH_URL=

# Database port | Default: 5432
POSTGRES_FUSIONAUTH_PORT=

# Application database user (read/write access)
POSTGRES_FUSIONAUTH_USER=

# Application user password | Min 20 alphanumeric characters
POSTGRES_FUSIONAUTH_PASSWORD=

# Database name
POSTGRES_FUSIONAUTH_DB=

# ──────────────────────────────────────────────────────────────────────────────

# ------------------------------------------------------------------------------
# PostgreSQL - Grafana Database
# ------------------------------------------------------------------------------
# JDBC connection URL | Format: jdbc:postgresql://<host>:<port>/<database>
POSTGRES_GRAFANA_URL=

# Database port | Default: 5432
POSTGRES_GRAFANA_PORT=

# Application database user (read/write access)
POSTGRES_GRAFANA_USER=

# Application user password | Min 20 alphanumeric characters
POSTGRES_GRAFANA_PASSWORD=

# Database name
POSTGRES_GRAFANA_DB=

# ──────────────────────────────────────────────────────────────────────────────

# ------------------------------------------------------------------------------
# FusionAuth Application
# ------------------------------------------------------------------------------
# JVM memory allocation | Format: <number>m or <number>g | Example: 512m, 1g
FUSIONAUTH_APP_MEMORY=

# Runtime mode | Values: development, production
FUSIONAUTH_APP_RUNTIME_MODE=

# Public URL | Example: http://localhost:9011 or https://auth.example.com
FUSIONAUTH_APP_URL=

# Administrative API key | Min 20 alphanumeric characters
FUSIONAUTH_API_KEY=

# Log level | Values: TRACE, DEBUG, INFO, WARN, ERROR
FUSIONAUTH_APP_LOG_LEVEL=

# Initial administrator password | Min 20 alphanumeric characters
FUSIONAUTH_ADMIN_PASSWORD=

# Unique identifier for the FusionAuth application | Example: 6b4194ba-0f86-470c-8194-ba0f86670cd7
FUSIONAUTH_APPLICATION_ID=

# Search engine type | Values: database, elasticsearch
FUSIONAUTH_APP_SEARCH_TYPE=

# ──────────────────────────────────────────────────────────────────────────────

# ------------------------------------------------------------------------------
# Scheduled Jobs
# ------------------------------------------------------------------------------
# System backup retention period in days | Example: 7
BACKUP_RETENTION_DAYS=

# Data export retention period in days | Example: 30
EXPORT_RETENTION_DAYS=

# Target Kubernetes namespaces (comma-separated) | Example: develop,staging
TARGET_NAMESPACES=

# ──────────────────────────────────────────────────────────────────────────────

# ============================================
#  EUREKA DISCOVERY SERVER - ENVIRONMENT CONFIG
# ============================================
# Configuration template for Eureka Discovery Server.
# Copy this file to .env and populate with environment-specific values.

# ============================================
#  INSTANCE CONFIGURATION
# ============================================

# EUREKA_PREFER_IP_ADDRESS
# Controls whether the service registers using IP address or hostname
# Type: boolean
# Values: true | false
# Default: false
# Required: No
# Example: true
EUREKA_PREFER_IP_ADDRESS=

# EUREKA_HOSTNAME
# Hostname identifier for this Eureka instance
# Type: string
# Used for: Peer communication, service URLs, dashboard access
# Required: Yes
# Example: localhost | eureka-server-1.local | discovery.conecta-seguros.com
EUREKA_HOSTNAME=

# ============================================
#  CLUSTER CONFIGURATION
# ============================================

# EUREKA_PEER_URLS
# Comma-separated list of peer Eureka server URLs for high availability clustering
# Type: string (comma-separated URLs)
# Required: No (leave empty for standalone mode)
# Example: http://eureka-2:8761/eureka,http://eureka-3:8761/eureka
# Production: Configure multiple peers for redundancy
EUREKA_PEER_URLS=

# EUREKA_ZONE
# Availability zone identifier for multi-zone deployments
# Type: string
# Used for: Region-aware load balancing and routing
# Required: No
# Default: defaultZone
# Example: us-east-1a | eu-west-1b | defaultZone
EUREKA_ZONE=

# ============================================
#  SECURITY CONFIGURATION
# ============================================

# EUREKA_USERNAME
# Basic authentication username for Eureka dashboard and REST API
# Type: string
# Required: Yes
# Note: Must match credentials configured in client services
# Example: admin | eureka-admin
# Production: Use secure credential management (e.g., Vault, Secrets Manager)
EUREKA_USERNAME=

# EUREKA_PASSWORD
# Basic authentication password for Eureka dashboard and REST API
# Type: string
# Required: Yes
# Security: Use strong passwords with min. 12 characters, mixed case, numbers, and symbols
# Example: StrongP@ssw0rd!2026
# Production: Rotate regularly and store securely
EUREKA_PASSWORD=

# ============================================
# Grafana
# ============================================
# GRAFANA_ADMIN_USER
# Initial Grafana administrator username
# Type: string
# Required: Yes
# Example: admin | grafana-admin
GRAFANA_ADMIN_USER=

# GRAFANA_ADMIN_PASSWORD
# Initial Grafana administrator password
# Type: string
# Required: Yes
# Security: Minimum 12 characters with mixed case, numbers, and symbols
# Example: Gr@fanaSecure!2026
GRAFANA_ADMIN_PASSWORD=

# ============================================
# Kite Dashboard
# ============================================
# KITE_ADMIN_PASSWORD
# Administrator password for Kite dashboard access
# Type: string
# Required: Yes
# Security: Minimum 12 characters with mixed case, numbers, and symbols
# Example: K1teAdmin!2026
KITE_ADMIN_PASSWORD=

# KITE_JWT_SECRET
# Secret used to sign and validate JWT tokens
# Type: string
# Required: Yes
# Security: Use a high-entropy random secret (at least 32 characters)
# Example: 4f9a8d2c6b1e7f3a9c5d2e8b1f6a7c3d
KITE_JWT_SECRET=

# KITE_ENCRYPT_KEY
# Symmetric key used to encrypt sensitive data in Kite
# Type: string
# Required: Yes
# Security: Use a high-entropy key aligned with your app cipher requirements
# Example: 9b7c5d3e1f8a6c4b2d9e7f5a3c1b8d6e
KITE_ENCRYPT_KEY=

# ============================================
# Cloudflare — DNS-01 Wildcard SSL
# ============================================
# CLOUDFLARE_API_TOKEN
# API token used by cert-manager for DNS-01 ACME challenges (wildcard certificates)
# Type: string
# Required: Yes (for wildcard SSL via Let's Encrypt)
# Permissions required: Zone:DNS:Edit, Zone:Zone:Read on caicedoseguros.com zone
# Create at: https://dash.cloudflare.com/profile/api-tokens
# Example: abc123def456ghi789...
CLOUDFLARE_API_TOKEN=

# ============================================
# Cloudflare Tunnel
# ============================================
# CLOUDFLARE_TUNNEL_TOKEN
# Token used by cloudflared to authenticate the tunnel with Cloudflare Zero Trust
# Type: string
# Required: Yes (for Cloudflare Tunnel ingress via Zero Trust)
# Generate at: Cloudflare Zero Trust → Networks → Tunnels → Create a tunnel → Docker tab (copy token)
# Example: eyJhIjoiYWJjMTIzLi4uIn0...
CLOUDFLARE_TUNNEL_TOKEN=
