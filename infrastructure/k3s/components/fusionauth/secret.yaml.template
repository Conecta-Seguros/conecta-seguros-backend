apiVersion: v1
kind: Secret
metadata:
  name: fusionauth-db-secret
  namespace: production
  labels:
    app: fusionauth
type: Opaque
stringData:
  # Database
  password: "CHANGE_ME_DB_PASSWORD"
  root-password: "CHANGE_ME_ROOT_PASSWORD"

  FUSIONAUTH_API_KEY: "CHANGE_ME_API_KEY_MIN_32_CHARS"
  FUSIONAUTH_ADMIN_PASSWORD: "CHANGE_ME_ADMIN_PASSWORD"
  FUSIONAUTH_APPLICATION_ID: "CHANGE_ME_APP_UUID"

  # Email SMTP
  FUSIONAUTH_APP_EMAIL_USERNAME: "smtp-user@company.com"
  FUSIONAUTH_APP_EMAIL_PASSWORD: "CHANGE_ME_SMTP_PASSWORD"

  FUSIONAUTH_LICENSE: "CHANGE_ME_LICENSE_KEY"